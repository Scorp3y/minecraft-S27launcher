{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ms27-launcher",
  "version": "0.1.0",
  "identifier": "com.sector27.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SECTOR 27 Launcher",
        "width": 1200,
        "height": 720,
        "minWidth": 1200,
        "minHeight": 720,
        "resizable": false,
        "center": true,
        "decorations": false,
        "maximized": false,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}